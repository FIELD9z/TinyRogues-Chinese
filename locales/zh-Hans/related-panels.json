      "translation": "<color=#FF2666><color=#FF2666>力量</color></color>: <color=#FF2666>?</color>\n<color=#26FF66><color=#26FF66>敏捷</color></color>: <color=#26FF66>?</color>\n<color=#26B0FF><color=#26B0FF>智力</color></color>: <color=#26B0FF>?</color>",
